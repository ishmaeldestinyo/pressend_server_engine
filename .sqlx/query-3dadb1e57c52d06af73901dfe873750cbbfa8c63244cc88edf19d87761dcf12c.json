  "query": "SELECT id, email, firstname, lastname, role, status, last_login_at, created_at\n           FROM admins\n           WHERE deleted_at IS NULL\n             AND ($1::text IS NULL OR role = $1)\n             AND ($2::text IS NULL OR status = $2)\n           ORDER BY created_at DESC\n           LIMIT $3 OFFSET $4",
