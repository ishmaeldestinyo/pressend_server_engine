{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            rr.id            AS reward_id,\n            rr.referrer_id,\n            rr.amount,\n            a.account_number,\n            a.account_name,\n            a.device_token,\n            a.firstname\n        FROM referral_rewards rr\n        JOIN accounts a ON a.id = rr.referrer_id\n        WHERE rr.status    = 'pending'\n          AND a.deleted_at IS NULL\n        FOR UPDATE OF rr SKIP LOCKED\n        ",
