  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            status,\n            email,\n            nin,\n            bvn,\n            email_verified\n        FROM accounts\n        WHERE email = $1\n           OR (nin = $2 AND $3 = 'NIN')\n           OR (bvn = $2 AND $3 = 'BVN')\n        LIMIT 1\n        ",
