APPLICATION_NAME=Blinq
APPLICATION_DESCRIPTION="Best fintech app"
APPLICATION_BASEURL=https://api.blinq.com.ng
FRONTEND_URL=blinq.com.ng
APPLICATION_CURRENT_VERSION=1.0.0

# ─── Docker Compose Variables ─────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=12345
POSTGRES_DB=blinq
REDIS_PASSWORD=

# ─── PostgreSQL (App) ─────────────────────────────────────────────────
POSTGRESQL_DBNAME=blinq
POSTGRESQL_USER=postgres
POSTGRESQL_PASSWORD=12345
POSTGRESQL_PORT=5432
POSTGRESQL_HOST=postgres
POSTGRESQL_DRIVER="postgresql+asyncpg"

DATABASE_URL=postgres://postgres:12345@postgres:5432/blinq
SQLX_OFFLINE=true

# ─── Redis ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Kafka ────────────────────────────────────────────────────────────
KAFKA_BROKER=kafka:9092

# Auth topics
KAFKA_TOPIC_ACCOUNT_SIGNUP=account.signup
KAFKA_TOPIC_ACCOUNT_OTP_SEND=account.otp.send
KAFKA_TOPIC_ACCOUNT_OTP_VERIFY=account.otp.verify
KAFKA_TOPIC_ACCOUNT_SIGNIN=account.signin
KAFKA_TOPIC_ACCOUNT_SUSPICIOUS_LOGIN=account.suspicious.login
KAFKA_TOPIC_ACCOUNT_DELETE=account.delete
KAFKA_TOPIC_ACCOUNT_NEW_DEVICE=account.new_device.login
KAFKA_TOPIC_ACCOUNT_DEVICE_UPDATE=account.device.update
KAFKA_TOPIC_OPEN_WALLET=account.wallet.open
KAFKA_ACCOUNT_LOGIN_SUCCESSFUL=account.login.successful

# Password topics
KAFKA_TOPIC_PASSWORD_CHANGE_REQUEST=account.password.change.request
KAFKA_TOPIC_PASSWORD_CHANGE_VERIFY=account.password.change.verify
KAFKA_TOPIC_PASSWORD_CHANGE_SUBMIT=account.password.change.submit

# Email topics
KAFKA_TOPIC_EMAIL_CHANGE_REQUEST=account.email.change.request
KAFKA_TOPIC_EMAIL_CHANGE_VERIFY=account.email.change.verify
KAFKA_TOPIC_EMAIL_CHANGE_SUBMIT=account.email.change.submit

# KYC / tier upgrade topics
KAFKA_TOPIC_TIER1_UPGRADE_REQUEST=account.tier1.upgrade.request
KAFKA_TOPIC_TIER2_UPGRADE=account.tier2.upgrade
KAFKA_TOPIC_TIER3_UPGRADE=account.tier3.upgrade
KAFKA_TOPIC_KYC_UPGRADE_STATUS=account.tier.upgrade.status

# Transfer topics
KAFKA_TOPIC_INTERNAL_TRANSFER_INITIATED=internal.transfer.initiated
KAFKA_TOPIC_EXTERNAL_TRANSFER_INITIATED=external.transfer.initiated
KAFKA_TOPIC_TRANSFER_RECIEVED=transfer.received
KAFKA_TOPIC_TRANSFER_INFLOW=transfer.inflow

# Panic topics
KAFKA_TOPIC_PANIC_ACTIVATED=panic.activated
KAFKA_TOPIC_PANIC_DEACTIVATED=panic.deactivated

# VAS topics
KAFKA_TOPIC_VAS_REQUESTED=vas.requested
KAFKA_TOPIC_VAS_STATUS=vas.transaction.status
KAFKA_TOPIC_VAS_BILLS_REQUESTED=vas-bills-requested
KAFKA_TOPIC_VAS_AIRTIME_REQUESTED=vas-airtime-requested
KAFKA_TOPIC_VAS_DATA_REQUESTED=vas-data-requested

# Posthumous topics
KAFKA_TOPIC_POSTHUMOUS_TRIGGERED=posthumous.triggered
KAFKA_TOPIC_POSTHUMOUS_REMINDER=posthumous.reminder
KAFKA_TOPIC_POSTHUMOUS_EXECUTING=posthumous.excuting
KAFKA_TOPIC_POSTHUMOUS_BENEFICIARY_NOTIFIED=posthumous.beneficiary.notified
KAFKA_TOPIC_LEGACYPLAN_BENEFICIARY_ADDED=legacyplan.beneficiary.added
KAFKA_TOPIC_POSTHUMOUS_BENEFICIARY_DELETED=posthumousl.beneficiary.deleted

# Payment topics
KAFKA_TOPIC_PAYMENT_PIN_SET=account.payment.pin.set

